# Customer Segmentation Application Configuration

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=10000
BACKEND_DEBUG=false

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=8000
API_BASE_URL=http://localhost:10000

# Model Configuration
MODEL_SAVE_PATH=backend/saved_model.pkl
SCALER_SAVE_PATH=backend/saved_scaler.pkl
PCA_SAVE_PATH=backend/saved_pca.pkl

# KMeans Configuration
KMEANS_RANDOM_STATE=42
KMEANS_N_INIT=10
KMEANS_MAX_ITER=500

# Data Processing
MAX_FILE_SIZE=50000000
ALLOWED_EXTENSIONS=csv
MIN_ROWS=5
MAX_ROWS=1000000

# UI Configuration
DARK_MODE_DEFAULT=false
THEME=light

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
